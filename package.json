{
	"name": "seintrack",
	"description": "Seinfeld calendar and prodcuct time tracking hybrid",
	"author": "Illispi",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env --import ./instrument.server.mjs .output/server/index.mjs",
		"sql": "kysely-codegen --dialect postgres --camel-case",
		"migrate:latest": "tsx ./src/tools/migrate.ts",
		"migrate:down": "tsx ./src/tools/migrate.ts down",
		"migrate:new": "tsx ./src/tools/migrationFile.ts",
		"check": "biome check",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@hono/trpc-server": "^0.4.2",
		"@kobalte/core": "^0.13.14",
		"@sentry/node": "^11.14.0",
		"@sentry/solid": "^11.14.0",
		"@solid-primitives/intersection-observer": "^2.1.6",
		"@solidjs/meta": "^0.29.8",
		"@solidjs/router": "^1.0.3",
		"@solidjs/start": "^2.0.4",
		"@tanstack/solid-query": "^5.108.0",
		"@tanstack/solid-query-devtools": "^5.108.0",
		"@trpc/client": "^11.28.2",
		"@trpc/server": "^11.28.2",
		"chart.js": "^4.6.1",
		"chartjs-plugin-datalabels": "^2.2.0",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^4.4.0",
		"flatpickr": "^4.6.13",
		"hono": "^4.13.18",
		"js-confetti": "^0.12.0",
		"kysely": "^0.29.9",
		"pg": "^8.23.1",
		"solid-js": "^1.9.19",
		"solid-transition-group": "^0.3.0",
		"superjson": "^2.2.6",
		"tailwind-merge": "^2.6.0",
		"valibot": "^1.5.0"
	},
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^24.0.0",
		"@types/pg": "^8.23.1",
		"autoprefixer": "^10.6.2",
		"eslint": "^9.13.0",
		"eslint-plugin-readable-tailwind": "^1.8.1",
		"eslint-plugin-tailwindcss": "^3.18.0",
		"kysely-codegen": "^0.20.0",
		"nitro": "3.0.261103-rc",
		"postcss": "^8.5.33",
		"tailwindcss": "^3.4.17",
		"tailwindcss-animate": "^1.0.7",
		"tsx": "^4.23.15",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.72.2",
		"vite": "^8.3.8"
	}
}
